# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Webhook signing secret: Stripe Dashboard → Developers → Webhooks → endpoint → Signing secret
# Endpoint URL: https://yourdomain.com/api/webhooks/stripe — enable event checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Apple Pay: Stripe Dashboard → Settings → Payment methods → Apple Pay → add bintsaeed.com and www.bintsaeed.com.
# Google Pay: Stripe Dashboard → Settings → Payment methods → Google Pay → enable (shows in Checkout on Chrome/Android when using automatic payment methods).
# American Express: NOT available for Stripe accounts based in the UAE (Stripe Cards docs). Amex may appear in Dashboard but is filtered at checkout for UAE merchants.
# Optional: Stripe Dashboard → Settings → Payment methods → payment method configuration ID (pmc_...) — must include every method you want (cards + wallets). Omit to use account default.
# STRIPE_PAYMENT_METHOD_CONFIGURATION=pmc_your_configuration_id

# --- PayPal (direct — required for UAE; Stripe PayPal is EU-only) ---
# Create app: https://developer.paypal.com/dashboard/applications
# Sandbox for testing, Live for production. Use the same Client ID in both vars below.
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_MODE=sandbox
# Optional webhook: PAYPAL_WEBHOOK_ID= (from PayPal Developer Dashboard)

# --- Stripe PayPal cpmt (NOT for UAE merchants — ignore unless Stripe confirms EU entity) ---
# STRIPE_PAYPAL_CUSTOM_PAYMENT_METHOD_TYPE=
# NEXT_PUBLIC_STRIPE_PAYPAL_CUSTOM_PAYMENT_METHOD_TYPE=
# STRIPE_PAYPAL_ENABLED=false

# Checkout uses multiple payment rails on one page (Stripe cards + direct PayPal + Mollie EU).
# Legacy single-provider override (usually leave unset):
# NEXT_PUBLIC_PAYMENT_PROVIDER=stripe
# PAYMENT_PROVIDER=stripe

# Mollie — iDEAL, Klarna, etc. (shown to EU/UK/CH visitors when enabled below)
# MOLLIE_API_KEY=test_your_mollie_api_key
# NEXT_PUBLIC_MOLLIE_CHECKOUT_ENABLED=true
# MOLLIE_CHECKOUT_EU_ONLY=true

# Optional BNPL landing URLs (legacy placeholders — prefer full API integration below).
# NEXT_PUBLIC_TABBY_CHECKOUT_URL=https://
# NEXT_PUBLIC_TAMARA_CHECKOUT_URL=https://

# --- Tabby (Pay in 4) — stack is wired; stays OFF until keys + flag ---
# From Tabby merchant dashboard / partner email after approval:
# TABBY_SECRET_KEY=                    # Bearer secret (test or live — Tabby detects env from the key)
# TABBY_MERCHANT_CODE=                 # Required (X-Merchant-Code)
# NEXT_PUBLIC_TABBY_PUBLIC_KEY=        # Optional — promo/widget public key when they send it
# TABBY_WEBHOOK_SECRET=                # Optional — shared secret for /api/webhooks/tabby
# TABBY_API_BASE_URL=https://api.tabby.ai   # UAE/KW default; KSA is https://api.tabby.sa (auto by currency if unset)
# NEXT_PUBLIC_TABBY_CHECKOUT_ENABLED=false  # Flip to true only after keys work in sandbox/live
# Webhook URL to register with Tabby: https://www.bintsaeed.com/api/webhooks/tabby

# Tamara sandbox (from partners-sandbox email) — do not commit real tokens
# TAMARA_API_BASE_URL=https://api-sandbox.tamara.co
# TAMARA_API_TOKEN=          # JWT only, no "Bearer " prefix
# TAMARA_NOTIFICATION_TOKEN= # webhook HS256 secret
# NEXT_PUBLIC_TAMARA_PUBLIC_KEY=  # widget public key (starts with e00…)
# NEXT_PUBLIC_TAMARA_CHECKOUT_ENABLED=true

# Slack Integration (for contact form & order notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack Analytics (for visitor tracking notifications)
SLACK_ANALYTICS_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/ANALYTICS/WEBHOOK
# Slack Recovery (optional: abandoned cart / recovery alerts on a separate channel)
# SLACK_RECOVERY_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/RECOVERY/WEBHOOK
# Slack Abandoned Cart (optional: override just abandoned/recovery alerts to another channel)
# SLACK_ABANDONED_CART_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/ABANDONED/CART/WEBHOOK
# Slack Orders (optional: dedicated paid-order alerts, e.g. #client-orders)
# SLACK_ORDERS_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/CLIENT/ORDERS/WEBHOOK
# Slack Fulfillment (optional: status transitions such as processing → shipped → delivered)
# SLACK_FULFILLMENT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/FULFILLMENT/WEBHOOK
# Slack Health (optional: website/API failure alerts)
# SLACK_HEALTH_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/HEALTH/WEBHOOK

# Trello automation (optional: create a client-order card automatically after paid checkout)
# TRELLO_API_KEY=
# TRELLO_API_TOKEN=
# TRELLO_CLIENT_ORDERS_LIST_ID=

# Transactional email (account verification + order confirmations + subscribe thank-you) — https://resend.com
# RESEND_API_KEY=
# Verified sender, e.g. Bint Saeed <hello@yourdomain.com> (or onboarding@resend.dev for tests)
# RESEND_FROM_EMAIL=
# Optional dedicated sender for order confirmations (falls back to RESEND_FROM_EMAIL)
# e.g. Bint Saeed <orders@bintsaeed.com>
# RESEND_ORDER_FROM_EMAIL=
# Where new-order alert emails are sent so you never miss an order (comma-separated for a team).
# Defaults to orderconfirmation@bintsaeed.com,sunaina@bintsaeed.com. Requires RESEND_API_KEY.
# ORDER_ALERT_EMAIL=orderconfirmation@bintsaeed.com,sunaina@bintsaeed.com

# Customer sign-in sessions (min 16 chars). Signs the bs_user cookie after email or Google login.
# USER_SESSION_SECRET=

# Google OAuth (customer sign-in) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://www.bintsaeed.com/api/auth/google/callback (and localhost for dev)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Verified accounts storage (production). Free tier: https://upstash.com
# Without these, registration uses in-memory storage (dev only — not for serverless multi-instance).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Used in verification email links if VERCEL_URL is unset — production: https://www.bintsaeed.com (matches canonical + sitemap)
# NEXT_PUBLIC_SITE_URL=https://www.bintsaeed.com

# --- IndexNow (Bing / Yandex) — https://www.indexnow.org/
# 1) Generate INDEXNOW_KEY: 8–128 chars, only [a-zA-Z0-9-] (e.g. openssl rand -hex 8)
# 2) Set NEXT_PUBLIC_SITE_URL to your live origin (must match URLs you submit, usually https://www.bintsaeed.com)
# 3) Deploy — proof URL is served automatically at https://{origin}/{INDEXNOW_KEY}.txt (see app/[filename]/route.ts)
# 4) In Bing Webmaster → IndexNow, enter the same key (or import URL above)
# 5) Optional: set INDEXNOW_WEBHOOK_SECRET, then POST /api/indexnow/publish with Authorization: Bearer <secret> to ping all sitemap URLs
# INDEXNOW_KEY=
# INDEXNOW_WEBHOOK_SECRET=

# Comma-separated origins allowed to start Stripe Checkout (production). Defaults: https://bintsaeed.com, https://www.bintsaeed.com
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# MailerLite Integration (for newsletter subscription)
# Get API token: MailerLite Dashboard → Integrations → MailerLite API → Use → Generate new token
# Get Group ID: MailerLite Dashboard → Integrations → MailerLite API → Use → scroll to Groups section
# Group ID is optional - without it, subscribers go to main audience
MAILERLITE_API_KEY=your_mailerlite_api_token
MAILERLITE_GROUP_ID=your_group_id_optional

# Privacy-aware analytics (optional; loaded only after user consent)
# GA4 measurement id (example: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Microsoft Clarity project id
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# PostHog free tier (optional; requires both key + host)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Index mode: "prelaunch" = only `/` + `/coming-soon` in sitemap (see lib/sitemapUrlList.ts).
# Many section layouts still attach noindex via lib/seo.ts until you switch to live.
# Set NEXT_PUBLIC_INDEX_MODE=live when the shop + editorial URLs should be indexed broadly.
NEXT_PUBLIC_INDEX_MODE=prelaunch

# --- Go-live checklist (public site) ---
# 1) NEXT_PUBLIC_COMING_SOON_ONLY=false  — stop middleware forcing unknown paths to `/`
# 2) NEXT_PUBLIC_INDEX_MODE=live          — expand sitemap; relax noindex on section layouts
# 3) COMING_SOON_REDIRECT_TO_ROOT=true    — `/coming-soon` → `/home`
# 4) PREVIEW_GATE_DISABLED=true           — public `/home` (no password gate)
# 5) NEXT_PUBLIC_SITE_URL=https://www.bintsaeed.com — matches robots host + sitemap loc URLs
# With COMING_SOON_ONLY=false, middleware also 308-redirects `/` and `/coming-soon` (and locale roots) to `/home`.
# Redeploy after changing these.

# When "true", only the coming-soon page at `/` is reachable for normal browsing; all other
# paths (e.g. `/home`, `/shop`) redirect to `/`. APIs, `/_next`, static files, and `/admin` still work.
# Omit or set to "false" while building/testing the full site. Set to "true" on production until launch.
# NEXT_PUBLIC_COMING_SOON_ONLY=true
# When "true", `/coming-soon` redirects to `/` so bookmarks and SERP URLs consolidate on the homepage.
# COMING_SOON_REDIRECT_TO_ROOT=false

# WhatsApp floating button (optional). Default in code is +971502299402. Use digits or +E.164, e.g. +971502299402
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Editorial home gate (/home, /home/gate, /home/blocked); old /preview URLs redirect to /home ---
# Create reCAPTCHA v3 keys: https://www.google.com/recaptcha/admin (register domain + localhost for dev)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# Random secret, min 16 characters, used to sign the preview access cookie
# PREVIEW_GATE_SECRET=
# Set to "true" to disable the preview gate locally (no keys required)
# PREVIEW_GATE_DISABLED=true

# --- Owner admin (/admin/orders, /admin/products, /admin/dashboard) ---
# Random secret min 16 chars — signs the admin session cookie (same pattern as preview gate)
# ADMIN_DASHBOARD_SECRET=your-long-random-secret-min-16-chars
# Password you type on /admin/login
# ADMIN_DASHBOARD_PASSWORD=your-strong-password
